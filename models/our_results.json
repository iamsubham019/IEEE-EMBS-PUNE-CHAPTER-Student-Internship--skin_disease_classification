{
  "project": "Skin Disease Classification — IEEE EMBS Pune Chapter Student Internship 2026",
  "team": "CodeCrafters | Team ID: AI ML-21",
  "week": "Week 4 — Final",
  "dataset": {
    "base": "HAM10000",
    "augmentation": "ISIC-2019 rare-class boost (deduplicated)",
    "split_method": "GroupShuffleSplit on lesion_id (leak-free)",
    "train_images": 8497,
    "val_images": 1838,
    "test_images": 1852,
    "num_classes": 7,
    "classes": ["akiec", "bcc", "bkl", "df", "mel", "nv", "vasc"]
  },
  "model": {
    "backbone": "EfficientNet-B3",
    "pretrained": "ImageNet1K",
    "classifier_head": "Dropout(0.2) + Linear(1536, 7)",
    "weight_init": "Orthogonal seeding (gain=1.2)",
    "optimizer": "AdamW",
    "learning_rate": 0.0007,
    "weight_decay": 0.00001,
    "batch_size": 32,
    "scheduler": "CosineAnnealingLR",
    "precision": "Mixed (AMP Autocast)",
    "class_weighting": "Logarithmic smoothing — log(1+w), capped at 4x ratio"
  },
  "results_7class": {
    "train": {
      "accuracy": 0.9924,
      "weighted_f1": 0.9919
    },
    "validation": {
      "accuracy": 0.9921,
      "weighted_f1": 0.9913
    },
    "test": {
      "accuracy": 0.9921,
      "weighted_f1": 0.9911
    }
  },
  "results_binary": {
    "class_mapping": {
      "malignant": ["mel", "bcc", "akiec"],
      "benign": ["nv", "bkl", "df", "vasc"]
    },
    "binary_accuracy": 0.9921,
    "weighted_f1": 0.9911,
    "auc_roc": 0.9997
  },
  "explainability": {
    "method": "Grad-CAM",
    "coverage": "All 7 classes x 3 backbones"
  },
  "preprocessing": {
    "hair_removal": "BlackHat morphological filter (9x9 elliptical kernel) + Telea inpainting",
    "contrast": "CLAHE on LAB L-channel (clipLimit=2.0, tileGridSize=8x8)",
    "resize": "224x224",
    "normalisation": "ImageNet stats (mean=[0.485,0.456,0.406], std=[0.229,0.224,0.225])",
    "note": "All preprocessing baked into Dataset class — zero train/inference distribution shift"
  },
  "software_demo": {
    "framework": "Streamlit",
    "author": "Sounok Ghosh",
    "features": [
      "7-class prediction",
      "Grad-CAM heatmap overlay",
      "Malignant/Benign badge",
      "OOD safety warning",
      "Top-3 predictions",
      "Real-time preprocessing preview"
    ]
  }
}
